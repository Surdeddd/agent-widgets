import AWKit
import SwiftUI

struct __TYPE__Bar: Codable, Sendable {
    let label: String
    let value: Double
}

struct __TYPE__Data: Codable, Sendable {
    let title: String
    let total: String
    let caption: String
    let bars: [__TYPE__Bar]
    let highlight: Int?
}

struct __TYPE__View: AWView {
    let entry: AWEntry<__TYPE__Data>
    @Environment(\.aw) private var context

    init(entry: AWEntry<__TYPE__Data>) {
        self.entry = entry
    }

    var body: some View {
        AWPhaseView(entry) { data in
            VStack(alignment: .leading, spacing: AWMetrics.spacing(for: context.family)) {
                AWHeader(data.title, symbol: "chart.bar.fill", entry: entry)
                if context.isWide {
                    HStack(alignment: .bottom, spacing: context.family == .medium ? AWSpace.m : AWSpace.xl) {
                        AWMetric(data.total, label: data.caption)
                            .frame(width: context.family == .medium ? 104 : 240, alignment: .leading)
                        chart(data)
                    }
                } else if context.isSmall {
                    AWMetric(data.total, label: data.caption)
                    Spacer(minLength: 0)
                    chart(data)
                        .frame(height: 38)
                } else {
                    HStack(alignment: .top, spacing: AWSpace.m) {
                        AWMetric(data.total, label: data.caption)
                        Spacer(minLength: 0)
                        facts(data)
                    }
                    chart(data)
                        .frame(maxHeight: .infinity)
                }
            }
        }
    }

    @ViewBuilder
    private func facts(_ data: __TYPE__Data) -> some View {
        if let best = data.bars.max(by: { $0.value < $1.value }) {
            let average = data.bars.map(\.value).reduce(0, +) / Double(data.bars.count)
            VStack(alignment: .trailing, spacing: AWSpace.xs) {
                fact(context.pick(en: "best", ru: "максимум"), "\(best.label) · \(Self.short(best.value))")
                fact(context.pick(en: "average", ru: "в среднем"), Self.short(average))
            }
        }
    }

    private func fact(_ label: String, _ value: String) -> some View {
        VStack(alignment: .trailing, spacing: 0) {
            AWText(label, .label)
                .foregroundStyle(.secondary)
            AWText(value, .headline)
                .monospacedDigit()
        }
    }

    static func short(_ value: Double) -> String {
        value == value.rounded() ? String(format: "%.0f", value) : String(format: "%.1f", value)
    }

    private func chart(_ data: __TYPE__Data) -> some View {
        let highlight = data.highlight ?? data.bars.count - 1
        let items = data.bars.enumerated().map { index, bar in
            AWBarItem(bar.label, bar.value, highlighted: index == highlight, id: "\(index)")
        }
        return AWBarChart(items, tint: .purple, showsLabels: !context.isSmall)
    }
}
