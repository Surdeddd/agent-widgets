import AWKit
import SwiftUI

struct __TYPE__Item: Codable, Sendable, Identifiable {
    var id: String { name }
    let name: String
    let value: String?
    let detail: String?
    let status: AWStatus
}

struct __TYPE__Data: Codable, Sendable {
    let title: String
    let items: [__TYPE__Item]
}

struct __TYPE__View: AWView {
    let entry: AWEntry<__TYPE__Data>
    @Environment(\.aw) private var context

    init(entry: AWEntry<__TYPE__Data>) {
        self.entry = entry
    }

    var body: some View {
        AWPhaseView(entry) { data in
            VStack(alignment: .leading, spacing: AWMetrics.spacing(for: context.family)) {
                AWHeader(data.title, symbol: "waveform.path.ecg", entry: entry)
                switch context.family {
                case .small:
                    summary(data)
                case .medium:
                    columns(data.items, rows: 3, detailed: false)
                case .large, .extraLarge:
                    rows(data.items, limit: 7, detailed: true)
                }
                Spacer(minLength: 0)
            }
        }
    }

    @ViewBuilder
    private func columns(_ items: [__TYPE__Item], rows limit: Int, detailed: Bool) -> some View {
        if items.count <= limit {
            rows(items, limit: limit, detailed: detailed)
        } else {
            let half = min(limit, (items.count + 1) / 2)
            HStack(alignment: .top, spacing: AWSpace.l) {
                rows(Array(items.prefix(half)), limit: limit, detailed: detailed)
                rows(Array(items.dropFirst(half)), limit: limit, detailed: detailed)
            }
        }
    }

    private func rows(_ items: [__TYPE__Item], limit: Int, detailed: Bool) -> some View {
        AWList(items, maxRows: limit) { item in
            AWRow(item.name, value: item.value, detail: detailed ? item.detail : nil, status: item.status)
        }
        .frame(maxWidth: .infinity, alignment: .leading)
    }

    private func summary(_ data: __TYPE__Data) -> some View {
        let failing = data.items.filter { $0.status == .critical || $0.status == .warning }
        return VStack(alignment: .leading, spacing: AWSpace.xs) {
            AWMetric("\(data.items.count - failing.count)/\(data.items.count)", label: context.pick(en: "healthy", ru: "в норме"))
            if let first = failing.first {
                AWBadge(first.name, status: first.status)
            }
        }
    }
}
