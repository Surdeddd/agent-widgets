import AWKit
import SwiftUI

struct __TYPE__Data: Codable, Sendable {
    let title: String
    let event: String
    let date: Date
    let since: Date?
    let symbol: String?
}

struct __TYPE__View: AWView {
    static var tick: AWTick { .every(seconds: 3600, count: 24) }

    let entry: AWEntry<__TYPE__Data>
    @Environment(\.aw) private var context

    init(entry: AWEntry<__TYPE__Data>) {
        self.entry = entry
    }

    var body: some View {
        AWPhaseView(entry) { data in
            VStack(alignment: .leading, spacing: AWMetrics.spacing(for: context.family)) {
                AWHeader(data.title, symbol: data.symbol ?? "hourglass", entry: entry)
                switch context.family {
                case .small:
                    AWText(data.event, .headline, lines: 2)
                    countdown(data)
                    Spacer(minLength: 0)
                case .medium:
                    HStack(alignment: .center, spacing: AWSpace.m) {
                        VStack(alignment: .leading, spacing: 2) {
                            AWText(data.event, .headline)
                            countdown(data)
                            AWText(when(data.date), .caption)
                                .foregroundStyle(.secondary)
                        }
                        .frame(maxWidth: .infinity, alignment: .leading)
                        elapsed(data, size: 100)
                    }
                    .frame(maxHeight: .infinity)
                case .large, .extraLarge:
                    Spacer(minLength: 0)
                    HStack(alignment: .center, spacing: context.family == .large ? AWSpace.m : AWSpace.xl) {
                        summary(data)
                            .frame(maxWidth: .infinity, alignment: .leading)
                        elapsed(data, size: context.family == .large ? 120 : 220)
                    }
                    Spacer(minLength: 0)
                }
            }
        }
    }

    private func summary(_ data: __TYPE__Data) -> some View {
        VStack(alignment: .leading, spacing: AWSpace.xs) {
            AWText(data.event, .display, lines: 2)
            countdown(data)
            AWText(when(data.date), .caption)
                .foregroundStyle(.secondary)
        }
    }

    @ViewBuilder
    private func elapsed(_ data: __TYPE__Data, size: CGFloat) -> some View {
        if let since = data.since {
            let fraction = Self.fraction(since: since, until: data.date, now: entry.date)
            AWRing(progress: fraction, tint: .orange) {
                VStack(spacing: 0) {
                    AWText("\(Int((fraction * 100).rounded()))%", .title)
                    AWText(context.pick(en: "elapsed", ru: "прошло"), .label)
                        .foregroundStyle(.secondary)
                }
            }
            .frame(width: size, height: size)
        }
    }

    @ViewBuilder
    private func countdown(_ data: __TYPE__Data) -> some View {
        let remaining = data.date.timeIntervalSince(entry.date)
        if remaining > 86_400 {
            AWMetric("\(Int(remaining / 86_400))", unit: context.pick(en: "days", ru: "дн"))
        } else if remaining > 0 {
            AWCountdown(to: data.date)
        } else {
            AWText(context.pick(en: "Now", ru: "Сейчас"), .hero)
        }
    }

    private func when(_ date: Date) -> String {
        date.formatted(.dateTime.day().month(.abbreviated).year().hour().minute().locale(context.locale))
    }

    static func fraction(since: Date, until: Date, now: Date) -> Double {
        let total = until.timeIntervalSince(since)
        guard total > 0 else { return 1 }
        return min(max(now.timeIntervalSince(since) / total, 0), 1)
    }
}
