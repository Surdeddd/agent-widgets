#!/usr/bin/env python3
import json
import os
import shutil

russian = os.environ.get("AW_LANG") == "ru"
settings = json.loads(os.environ.get("AW_SETTINGS") or "{}")
path = settings.get("path", "/")
usage = shutil.disk_usage(path)
free = usage.free / 1e9
total = usage.total / 1e9

history = []
previous = os.environ.get("AW_PREVIOUS_PATH")
if previous and os.path.exists(previous):
    with open(previous, encoding="utf-8") as handle:
        history = json.load(handle).get("history", [])
history = (history + [round(free, 1)])[-24:]
change = (history[-1] - history[0]) / history[0] if len(history) > 1 and history[0] else None

print(json.dumps({
    "title": "Свободно на диске" if russian else "Disk free",
    "value": round(free, 1),
    "unit": "ГБ" if russian else "GB",
    "caption": f"из {total:.0f} ГБ на {path}" if russian else f"of {total:.0f} GB on {path}",
    "change": change,
    "history": history,
}, ensure_ascii=False))
