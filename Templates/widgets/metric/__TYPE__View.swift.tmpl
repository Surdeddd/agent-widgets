import AWKit
import SwiftUI

struct __TYPE__Data: Codable, Sendable {
    let title: String
    let value: Double
    let unit: String
    let caption: String?
    let change: Double?
    let history: [Double]
}

struct __TYPE__View: AWView {
    let entry: AWEntry<__TYPE__Data>
    @Environment(\.aw) private var context

    init(entry: AWEntry<__TYPE__Data>) {
        self.entry = entry
    }

    var body: some View {
        AWPhaseView(entry) { data in
            VStack(alignment: .leading, spacing: AWMetrics.spacing(for: context.family)) {
                AWHeader(data.title, symbol: "internaldrive", entry: entry)
                if context.family == .medium {
                    HStack(alignment: .bottom, spacing: AWSpace.m) {
                        summary(data)
                        if data.history.count > 1 {
                            AWSparkline(data.history)
                                .frame(height: 64)
                        }
                    }
                } else if context.family == .extraLarge {
                    HStack(alignment: .bottom, spacing: AWSpace.xl) {
                        summary(data)
                            .frame(width: 200, alignment: .bottomLeading)
                        if data.history.count > 1 {
                            AWSparkline(data.history)
                                .frame(maxHeight: .infinity)
                        }
                    }
                } else if context.isSmall {
                    summary(data)
                    Spacer(minLength: 0)
                    if data.history.count > 1 {
                        AWSparkline(data.history)
                            .frame(height: 26)
                    }
                } else {
                    HStack(alignment: .top, spacing: AWSpace.m) {
                        summary(data)
                        Spacer(minLength: 0)
                        range(data)
                    }
                    if data.history.count > 1 {
                        AWSparkline(data.history)
                            .frame(maxHeight: .infinity)
                    }
                }
            }
        }
    }

    private func summary(_ data: __TYPE__Data) -> some View {
        VStack(alignment: .leading, spacing: 2) {
            AWMetric(format(data.value), unit: data.unit, trend: data.change.map { AWTrend.percent($0) })
            if let caption = data.caption, !context.isSmall {
                AWText(caption, .caption, lines: context.family == .extraLarge ? 3 : 1)
                    .foregroundStyle(.secondary)
            }
        }
    }

    @ViewBuilder
    private func range(_ data: __TYPE__Data) -> some View {
        if let high = data.history.max(), let low = data.history.min(), high > low {
            VStack(alignment: .trailing, spacing: AWSpace.xs) {
                fact(context.pick(en: "high", ru: "максимум"), "\(format(high)) \(data.unit)")
                fact(context.pick(en: "low", ru: "минимум"), "\(format(low)) \(data.unit)")
            }
        }
    }

    private func fact(_ label: String, _ value: String) -> some View {
        VStack(alignment: .trailing, spacing: 0) {
            AWText(label, .label)
                .foregroundStyle(.secondary)
            AWText(value, .headline)
                .monospacedDigit()
        }
    }

    private func format(_ value: Double) -> String {
        value >= 100 ? String(format: "%.0f", value) : String(format: "%.1f", value)
    }
}
